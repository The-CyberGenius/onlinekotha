# ============================================
# Kotha Environment Template (.env.example)
# Copy to .env and fill in your values
# ============================================

# --------------------------------------------
# 1. CORE SERVER & SECURITY (REQUIRED)
# --------------------------------------------
# Long random string to encrypt secrets & credentials at rest (min 32 chars in production)
ENCRYPTION_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Admin email(s) — sign up with this email to get full admin rights (comma-separated)
ADMIN_EMAIL=you@example.com

# Server port and public URL
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --------------------------------------------
# 2. AI PROVIDER API KEYS
# --------------------------------------------
# OpenRouter (Supports 300+ models): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Other AI Providers (Optional)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxx

# --------------------------------------------
# 3. DODO PAYMENTS (Billing & Subscriptions)
# --------------------------------------------
DODO_PRODUCT_ID=pdt_xxxxxxxxx
DODO_PRODUCT_ID_LIFETIME=pdt_xxxxxxxxx
DODO_PRODUCT_ID_MONTHLY=pdt_xxxxxxxxx
DODO_MONTHLY_PRODUCT_ID=pdt_xxxxxxxxx

# Dodo API Credentials (from Dodo Dashboard Developers)
# DODO_API_KEY=live_xxxxxxxxx
# DODO_WEBHOOK_SECRET=whsec_xxxxxxxxx

# --------------------------------------------
# 4. EMAIL / SMTP (Password reset & verification)
# --------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Kotha <noreply@yourdomain.com>

# --------------------------------------------
# 5. GOOGLE OAUTH (Sign In with Google)
# --------------------------------------------
# Create in Google Cloud Console → APIs & Services → Credentials
# Redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
